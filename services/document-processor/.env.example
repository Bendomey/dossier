# Values must be unquoted: Docker reads this file too.
# Supabase session pooler (port 5432) as the indexing_processor role.
DATABASE_URL=postgresql://indexing_processor.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dossier-documents
# From Google AI Studio, on a billing-enabled project.
GEMINI_API_KEY=
# Google directly; in production the Cloudflare AI Gateway:
# https://gateway.ai.cloudflare.com/v1/<account-id>/dossier/google-ai-studio
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# Only when GEMINI_BASE_URL is the gateway.
AI_GATEWAY_TOKEN=
# Scanned pages. Flash or Flash-Lite only: requests turn thinking off.
OCR_MODEL=gemini-2.5-flash-lite
OCR_MONTHLY_PAGE_LIMIT=500
EMBEDDING_MODEL=gemini-embedding-001
EMBED_REQUESTS_PER_MINUTE=100
PIPELINE_VERSION=1
CHUNK_TARGET_TOKENS=600
CHUNK_MAX_TOKENS=1000
CHUNK_OVERLAP_TOKENS=60
CHUNK_CHARS_PER_TOKEN=3
PORT=8080
