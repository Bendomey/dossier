NODE_ENV=development
API_ADDRESS=
SESSION_SECRET=

# Supabase: Project Settings > API (or Connect). The publishable key is public;
# never put the secret/service_role key here.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Server-only secret key (sb_secret_...): sends invitation emails. Never expose it to the browser.
SUPABASE_SECRET_KEY="sb_secret_..."

# Supabase: Project Settings > Database > Connection string.
# Runtime queries go through the transaction pooler (port 6543).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# The Prisma CLI prefers DIRECT_URL. Locally it points at a Postgres.app database
# where migrations are created and tried; CI sets it to Supabase's session pooler
# (port 5432) to deploy them.
DIRECT_URL="postgresql://localhost:5432/dossier_test"

# Cloudflare R2 (S3 API token with Object Read & Write on the bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dossier-documents
# Turns on the Upload button once the processor is live.
UPLOADS_ENABLED=false
# Until the processor runs on Cloudflare, development posts indexing requests
# straight to a local Go processor.
INDEXING_DISPATCH=direct
PROCESSOR_URL=http://localhost:8080/jobs
# Production publishes to Cloudflare Queues (token scoped to Queues: Edit).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
INDEXING_QUEUE_ID=

# Ask (AI chat). Needs indexed documents and the same EMBEDDING_MODEL as the processor.
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
AI_GATEWAY_TOKEN=
EMBEDDING_MODEL=gemini-embedding-001
ASK_MODEL=gemini-2.5-flash
INTENT_MODEL=gemini-2.5-flash-lite
RETRIEVAL_MIN_SIMILARITY=0.55
