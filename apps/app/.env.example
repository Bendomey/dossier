NODE_ENV=development
API_ADDRESS=
SESSION_SECRET=

# Supabase: Project Settings > API (or Connect). The publishable key is public;
# never put the secret/service_role key here.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Server-only secret key (sb_secret_...): sends invitation emails. Never expose it to the browser.
SUPABASE_SECRET_KEY="sb_secret_..."

# Supabase: Project Settings > Database > Connection string.
# Runtime queries go through the transaction pooler (port 6543).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Migrations need a session connection: the session pooler (port 5432) or the direct host.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Local development against Postgres.app instead:
# DATABASE_URL="postgresql://localhost:5432/dossier"
