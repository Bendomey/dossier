// Dossier's application database (Supabase Postgres).
//
// Every tenant-owned row carries organization_id, and child rows reference
// their parent with a composite (organization_id, id) foreign key, so the
// database itself rejects cross-organization links. IDs are generated by
// Postgres so services writing outside Prisma get them too.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// Countries Dossier serves; used as legal context in answers.
enum Country {
  GH
  LR
}

/// Language the AI answers in. MATCH replies in the language of the question.
enum ResponseLanguage {
  MATCH
  EN
  FR
  PT
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum AccessLevel {
  READ
  CONTRIBUTE
  MANAGE
}

enum DocumentType {
  CONSTITUTION
  CONTRACT
  POLICY
  HANDBOOK
  TEMPLATE
  AGREEMENT
  REPORT
  OTHER
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum TemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum IndexingStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum ChatStatus {
  ACTIVE
  ARCHIVED
}

enum ChatMemberRole {
  OWNER
  EDITOR
  VIEWER
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AiOperation {
  INTENT_DETECTION
  RETRIEVAL
  ANSWER
  GENERATION
  PROOFREADING
  CONTRACT_REVIEW
  COMPARISON
  EMBEDDING
}

enum AiRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum GeneratedDocumentStatus {
  DRAFT
  REVIEW
  APPROVED
  EXPORTED
  ARCHIVED
}

enum ReviewType {
  PROOFREADING
  CONTRACT_REVIEW
  COMPARISON
}

enum ReviewStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum FindingSeverity {
  HIGH
  MEDIUM
  LOW
}

enum FindingStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// ─── Identity ───────────────────────────────────────────────────────────────

/// One row per Supabase Auth user; `id` is auth.users.id.
model Profile {
  id          String   @id @db.Uuid
  /// Copied from auth.users by triggers (Supabase) so member lists need no auth-schema reads.
  email       String?
  displayName String?  @map("display_name")
  firstName   String?  @map("first_name")
  lastName    String?  @map("last_name")
  avatarUrl   String?  @map("avatar_url")
  locale      String?
  timezone    String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships               OrganizationMember[]
  invitationsSent           OrganizationInvitation[]
  groupsCreated             Group[]
  collectionsCreated        Collection[]
  documentsCreated          Document[]
  documentVersionsCreated   DocumentVersion[]
  templatesCreated          DocumentTemplate[]         @relation("TemplateCreatedBy")
  templatesApproved         DocumentTemplate[]         @relation("TemplateApprovedBy")
  chatsCreated              Chat[]
  messagesCreated           ChatMessage[]
  aiRuns                    AiRun[]
  generatedDocuments        GeneratedDocument[]
  generatedDocumentVersions GeneratedDocumentVersion[]
  reviews                   DocumentReview[]
  auditLogs                 AuditLog[]

  @@index([email])
  @@map("profiles")
}

model Organization {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  slug                   String             @unique
  logoUrl                String?            @map("logo_url")
  defaultLocale          String             @default("en") @map("default_locale")
  defaultTimezone        String             @default("Africa/Accra") @map("default_timezone")
  status                 OrganizationStatus @default(ACTIVE)
  country                Country            @default(GH)
  responseLanguage       ResponseLanguage   @default(MATCH) @map("response_language")
  /// Flag answers that have no source instead of showing them as fact.
  requireCitations       Boolean            @default(true) @map("require_citations")
  /// When false only owners and admins can upload, whatever a member's role allows.
  membersCanUpload       Boolean            @default(true) @map("members_can_upload")
  detectDocumentLanguage Boolean            @default(true) @map("detect_document_language")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  members                   OrganizationMember[]
  invitations               OrganizationInvitation[]
  invitationGroups          InvitationGroup[]
  roles                     Role[]
  groups                    Group[]
  groupMembers              GroupMember[]
  memberRoles               MemberRole[]
  collections               Collection[]
  collectionMembers         CollectionMember[]
  collectionGroups          CollectionGroup[]
  documents                 Document[]
  documentVersions          DocumentVersion[]
  templates                 DocumentTemplate[]
  indexingJobs              IndexingJob[]
  chunks                    DocumentChunk[]
  chats                     Chat[]
  chatMembers               ChatMember[]
  chatMessages              ChatMessage[]
  chatAttachments           ChatAttachment[]
  citations                 MessageCitation[]
  aiRuns                    AiRun[]
  generatedDocuments        GeneratedDocument[]
  generatedDocumentVersions GeneratedDocumentVersion[]
  reviews                   DocumentReview[]
  reviewFindings            ReviewFinding[]
  auditLogs                 AuditLog[]

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         Profile            @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles        MemberRole[]
  groups       GroupMember[]
  collections  CollectionMember[]
  chats        ChatMember[]

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([userId])
  @@map("organization_members")
}

model OrganizationInvitation {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  email          String
  invitedById    String?          @map("invited_by") @db.Uuid
  roleId         String?          @map("role_id") @db.Uuid
  status         InvitationStatus @default(PENDING)
  /// SHA-256 of the token sent by email; the token itself is never stored.
  tokenHash      String           @unique @map("token_hash")
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    Profile?          @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  role         Role?             @relation(fields: [roleId], references: [id], onDelete: SetNull)
  groups       InvitationGroup[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([email])
  @@map("organization_invitations")
}

/// Groups an invited person joins when they accept.
model InvitationGroup {
  organizationId String @map("organization_id") @db.Uuid
  invitationId   String @map("invitation_id") @db.Uuid
  groupId        String @map("group_id") @db.Uuid

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitation   OrganizationInvitation @relation(fields: [organizationId, invitationId], references: [organizationId, id], onDelete: Cascade)
  group        Group                  @relation(fields: [organizationId, groupId], references: [organizationId, id], onDelete: Cascade)

  @@id([invitationId, groupId])
  @@index([groupId])
  @@map("invitation_groups")
}

// ─── Authorization ──────────────────────────────────────────────────────────

/// organization_id is null for the built-in system roles shared by every organization.
model Role {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  name           String
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  members      MemberRole[]
  invitations  OrganizationInvitation[]

  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String  @unique
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model MemberRole {
  organizationId String @map("organization_id") @db.Uuid
  membershipId   String @map("membership_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMember @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)
  role         Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([roleId])
  @@map("member_roles")
}

model Group {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  /// The built-in Everyone group: every member belongs to it and it cannot be edited.
  isSystem       Boolean  @default(false) @map("is_system")
  createdById    String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    Profile?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  members      GroupMember[]
  collections  CollectionGroup[]
  invitations  InvitationGroup[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("groups")
}

model GroupMember {
  organizationId String @map("organization_id") @db.Uuid
  groupId        String @map("group_id") @db.Uuid
  membershipId   String @map("membership_id") @db.Uuid

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group        Group              @relation(fields: [organizationId, groupId], references: [organizationId, id], onDelete: Cascade)
  membership   OrganizationMember @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)

  @@id([groupId, membershipId])
  @@index([membershipId])
  @@map("group_members")
}

// ─── Knowledge ──────────────────────────────────────────────────────────────

model Collection {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  parentId       String?  @map("parent_id") @db.Uuid
  name           String
  description    String?
  type           String   @default("general")
  createdById    String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Collection?        @relation("CollectionTree", fields: [organizationId, parentId], references: [organizationId, id], onDelete: Restrict)
  children     Collection[]       @relation("CollectionTree")
  createdBy    Profile?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  members      CollectionMember[]
  groups       CollectionGroup[]
  documents    Document[]

  @@unique([organizationId, id])
  @@index([organizationId, parentId])
  @@map("collections")
}

model CollectionMember {
  organizationId String      @map("organization_id") @db.Uuid
  collectionId   String      @map("collection_id") @db.Uuid
  membershipId   String      @map("membership_id") @db.Uuid
  permission     AccessLevel @default(READ)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  collection   Collection         @relation(fields: [organizationId, collectionId], references: [organizationId, id], onDelete: Cascade)
  membership   OrganizationMember @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)

  @@id([collectionId, membershipId])
  @@index([membershipId])
  @@map("collection_members")
}

model CollectionGroup {
  organizationId String      @map("organization_id") @db.Uuid
  collectionId   String      @map("collection_id") @db.Uuid
  groupId        String      @map("group_id") @db.Uuid
  permission     AccessLevel @default(READ)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  collection   Collection   @relation(fields: [organizationId, collectionId], references: [organizationId, id], onDelete: Cascade)
  group        Group        @relation(fields: [organizationId, groupId], references: [organizationId, id], onDelete: Cascade)

  @@id([collectionId, groupId])
  @@index([groupId])
  @@map("collection_groups")
}

model Document {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  collectionId     String         @map("collection_id") @db.Uuid
  name             String
  description      String?
  documentType     DocumentType   @default(OTHER) @map("document_type")
  status           DocumentStatus @default(ACTIVE)
  currentVersionId String?        @unique @map("current_version_id") @db.Uuid
  createdById      String?        @map("created_by") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz(3)

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  collection     Collection         @relation(fields: [organizationId, collectionId], references: [organizationId, id], onDelete: Restrict)
  currentVersion DocumentVersion?   @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       DocumentVersion[]  @relation("DocumentVersions")
  createdBy      Profile?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  templates      DocumentTemplate[]
  chunks         DocumentChunk[]
  attachments    ChatAttachment[]
  citations      MessageCitation[]
  reviews        DocumentReview[]

  @@unique([organizationId, id])
  @@index([organizationId, collectionId])
  @@index([organizationId, status])
  @@map("documents")
}

/// Versions are never overwritten; a replacement upload adds a new row.
model DocumentVersion {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  versionNumber  Int      @map("version_number")
  /// Object key in Cloudflare R2; the file itself never lives in the database.
  fileKey        String   @map("file_key")
  fileName       String   @map("file_name")
  mimeType       String   @map("mime_type")
  fileSize       BigInt   @map("file_size")
  checksum       String?
  language       String?
  createdById    String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     Document          @relation("DocumentVersions", fields: [organizationId, documentId], references: [organizationId, id], onDelete: Cascade)
  currentOf    Document?         @relation("CurrentVersion")
  createdBy    Profile?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  indexingJobs IndexingJob[]
  chunks       DocumentChunk[]
  citations    MessageCitation[]

  @@unique([documentId, versionNumber])
  @@unique([organizationId, id])
  @@map("document_versions")
}

/// A document the AI may use as a generation source once approved.
model DocumentTemplate {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  documentId     String         @map("document_id") @db.Uuid
  name           String
  description    String?
  documentType   DocumentType   @default(TEMPLATE) @map("document_type")
  status         TemplateStatus @default(DRAFT)
  isApproved     Boolean        @default(false) @map("is_approved")
  createdById    String?        @map("created_by") @db.Uuid
  approvedById   String?        @map("approved_by") @db.Uuid
  approvedAt     DateTime?      @map("approved_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     Document     @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Cascade)
  createdBy    Profile?     @relation("TemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy   Profile?     @relation("TemplateApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([organizationId, isApproved])
  @@map("document_templates")
}

// ─── Indexing ───────────────────────────────────────────────────────────────

model IndexingJob {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String         @map("organization_id") @db.Uuid
  documentVersionId String         @map("document_version_id") @db.Uuid
  status            IndexingStatus @default(QUEUED)
  /// 0-100, reported by the processor for the upload progress UI.
  progress          Int            @default(0)
  attempts          Int            @default(0)
  errorMessage      String?        @map("error_message")
  startedAt         DateTime?      @map("started_at") @db.Timestamptz(3)
  completedAt       DateTime?      @map("completed_at") @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion @relation(fields: [organizationId, documentVersionId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([documentVersionId])
  @@map("indexing_jobs")
}

model DocumentChunk {
  id                String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String                       @map("organization_id") @db.Uuid
  /// Denormalized so retrieval can filter by permitted documents without joining versions.
  documentId        String                       @map("document_id") @db.Uuid
  documentVersionId String                       @map("document_version_id") @db.Uuid
  chunkIndex        Int                          @map("chunk_index")
  content           String
  contentHash       String                       @map("content_hash")
  pageNumber        Int?                         @map("page_number")
  sectionTitle      String?                      @map("section_title")
  tokenCount        Int                          @map("token_count")
  /// Page, section, heading, paragraph and table positions used by citations.
  metadata          Json                         @default("{}")
  embedding         Unsupported("vector(1536)")?
  createdAt         DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document        Document          @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Cascade)
  documentVersion DocumentVersion   @relation(fields: [organizationId, documentVersionId], references: [organizationId, id], onDelete: Cascade)
  citations       MessageCitation[]

  @@unique([documentVersionId, chunkIndex])
  @@unique([organizationId, id])
  @@index([organizationId, documentId])
  @@map("document_chunks")
}

// ─── AI workspace ───────────────────────────────────────────────────────────

model Chat {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String     @map("organization_id") @db.Uuid
  createdById     String     @map("created_by") @db.Uuid
  title           String
  status          ChatStatus @default(ACTIVE)
  modelPreference String?    @map("model_preference")
  language        String?
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt      DateTime?  @map("archived_at") @db.Timestamptz(3)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy          Profile             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  members            ChatMember[]
  messages           ChatMessage[]
  attachments        ChatAttachment[]
  aiRuns             AiRun[]
  generatedDocuments GeneratedDocument[]
  reviews            DocumentReview[]

  @@unique([organizationId, id])
  @@index([organizationId, createdById, updatedAt])
  @@map("chats")
}

model ChatMember {
  organizationId String         @map("organization_id") @db.Uuid
  chatId         String         @map("chat_id") @db.Uuid
  membershipId   String         @map("membership_id") @db.Uuid
  role           ChatMemberRole @default(VIEWER)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chat         Chat               @relation(fields: [organizationId, chatId], references: [organizationId, id], onDelete: Cascade)
  membership   OrganizationMember @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)

  @@id([chatId, membershipId])
  @@index([membershipId])
  @@map("chat_members")
}

model ChatMessage {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  chatId         String      @map("chat_id") @db.Uuid
  role           MessageRole
  content        String
  sequence       Int
  createdById    String?     @map("created_by") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chat         Chat              @relation(fields: [organizationId, chatId], references: [organizationId, id], onDelete: Cascade)
  createdBy    Profile?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  attachments  ChatAttachment[]
  citations    MessageCitation[]
  aiRuns       AiRun[]

  @@unique([chatId, sequence])
  @@unique([organizationId, id])
  @@map("chat_messages")
}

/// A file attached to one conversation, separate from company knowledge unless document_id is set.
model ChatAttachment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  chatId         String   @map("chat_id") @db.Uuid
  messageId      String?  @map("message_id") @db.Uuid
  documentId     String?  @map("document_id") @db.Uuid
  fileKey        String   @map("file_key")
  fileName       String   @map("file_name")
  mimeType       String   @map("mime_type")
  fileSize       BigInt   @map("file_size")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chat         Chat         @relation(fields: [organizationId, chatId], references: [organizationId, id], onDelete: Cascade)
  message      ChatMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  document     Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([chatId])
  @@map("chat_attachments")
}

model MessageCitation {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  messageId         String   @map("message_id") @db.Uuid
  documentId        String   @map("document_id") @db.Uuid
  documentVersionId String   @map("document_version_id") @db.Uuid
  chunkId           String?  @map("chunk_id") @db.Uuid
  pageNumber        Int?     @map("page_number")
  quotedText        String?  @map("quoted_text")
  relevanceScore    Decimal? @map("relevance_score") @db.Decimal(6, 5)
  citationOrder     Int      @map("citation_order")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  message         ChatMessage     @relation(fields: [organizationId, messageId], references: [organizationId, id], onDelete: Cascade)
  document        Document        @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Cascade)
  documentVersion DocumentVersion @relation(fields: [organizationId, documentVersionId], references: [organizationId, id], onDelete: Cascade)
  chunk           DocumentChunk?  @relation(fields: [chunkId], references: [id], onDelete: SetNull)

  @@unique([messageId, citationOrder])
  @@index([documentId])
  @@map("message_citations")
}

/// Every model call, wherever it happens (chat, review, generation, embedding).
model AiRun {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  chatId         String?     @map("chat_id") @db.Uuid
  messageId      String?     @map("message_id") @db.Uuid
  userId         String?     @map("user_id") @db.Uuid
  provider       String
  model          String
  operation      AiOperation
  status         AiRunStatus @default(RUNNING)
  inputTokens    Int?        @map("input_tokens")
  outputTokens   Int?        @map("output_tokens")
  latencyMs      Int?        @map("latency_ms")
  errorCode      String?     @map("error_code")
  metadata       Json        @default("{}")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt    DateTime?   @map("completed_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chat         Chat?        @relation(fields: [chatId], references: [id], onDelete: SetNull)
  message      ChatMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  user         Profile?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, operation, createdAt])
  @@map("ai_runs")
}

// ─── Document workspace ─────────────────────────────────────────────────────

model GeneratedDocument {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  createdById    String?                 @map("created_by") @db.Uuid
  chatId         String?                 @map("chat_id") @db.Uuid
  name           String
  documentType   DocumentType            @default(OTHER) @map("document_type")
  status         GeneratedDocumentStatus @default(DRAFT)
  fileKey        String?                 @map("file_key")
  mimeType       String?                 @map("mime_type")
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    Profile?                   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  chat         Chat?                      @relation(fields: [chatId], references: [id], onDelete: SetNull)
  versions     GeneratedDocumentVersion[]

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@map("generated_documents")
}

model GeneratedDocumentVersion {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  generatedDocumentId String   @map("generated_document_id") @db.Uuid
  versionNumber       Int      @map("version_number")
  content             String
  fileKey             String?  @map("file_key")
  createdById         String?  @map("created_by") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  generatedDocument GeneratedDocument @relation(fields: [organizationId, generatedDocumentId], references: [organizationId, id], onDelete: Cascade)
  createdBy         Profile?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([generatedDocumentId, versionNumber])
  @@map("generated_document_versions")
}

model DocumentReview {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  documentId     String?      @map("document_id") @db.Uuid
  chatId         String?      @map("chat_id") @db.Uuid
  createdById    String?      @map("created_by") @db.Uuid
  reviewType     ReviewType   @map("review_type")
  status         ReviewStatus @default(PENDING)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     Document?       @relation(fields: [documentId], references: [id], onDelete: SetNull)
  chat         Chat?           @relation(fields: [chatId], references: [id], onDelete: SetNull)
  createdBy    Profile?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  findings     ReviewFinding[]

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@map("document_reviews")
}

model ReviewFinding {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  reviewId       String          @map("review_id") @db.Uuid
  severity       FindingSeverity
  category       String
  title          String
  description    String
  originalText   String?         @map("original_text")
  suggestedText  String?         @map("suggested_text")
  pageNumber     Int?            @map("page_number")
  status         FindingStatus   @default(OPEN)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  review       DocumentReview @relation(fields: [organizationId, reviewId], references: [organizationId, id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_findings")
}

// ─── Audit ──────────────────────────────────────────────────────────────────

/// Written server-side only; never from what the browser reports.
model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  /// Dotted event name, e.g. document.uploaded, member.invited.
  action         String
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id") @db.Uuid
  ipAddress      String?  @map("ip_address") @db.Inet
  userAgent      String?  @map("user_agent")
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        Profile?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, resourceType, resourceId])
  @@map("audit_logs")
}
